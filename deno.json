{
  "tasks": {
    "build": "deno check apps/web/main.ts",
    "build:web": "deno run -A --watch --env-file=.env apps/web/main.ts",
    "build:mac": "deno compile --allow-all --env-file=.env --include apps/web/public --output dist/thirsty-mac apps/admin/src/main.ts",
    "build:windows": "deno compile --allow-all --env-file=.env --include apps/web/public --output dist/thirsty-win.exe apps/admin/src/main.ts",
    "build:ps2": "echo ps2 build stub"
  },
  "deploy": {
    "build": "deno task build",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./apps/web/main.ts"
    }
  }
}
